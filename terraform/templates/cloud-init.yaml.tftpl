#cloud-config
package_update: true
packages:
  - docker.io

write_files:
  - path: /opt/redmine/.env
    owner: root:root
    permissions: "0600"
    content: |
      REDMINE_DB_POSTGRES=${database_host}
      REDMINE_DB_PORT=6432
      REDMINE_DB_DATABASE=${database_name}
      REDMINE_DB_USERNAME=${database_username}
      REDMINE_DB_PASSWORD=${database_password}
      SECRET_KEY_BASE=${secret_key_base}

runcmd:
  - systemctl enable --now docker
  - mkdir -p /opt/redmine/files
  - docker pull ${redmine_image}
  - docker rm --force redmine || true
  - >-
    docker run --detach
    --name redmine
    --restart unless-stopped
    --env-file /opt/redmine/.env
    --publish 3000:3000
    --volume /opt/redmine/files:/usr/src/redmine/files
    ${redmine_image}
